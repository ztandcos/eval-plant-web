@@ -52,12 +57,12 @@ async def test_matching_preinstalled_sdk_skips_heavy_install(tmp_path) -> None:
     assert ensure_dependencies.await_args.args[1] == ("bash", "coreutils")
     exec_as_agent.assert_not_awaited()
